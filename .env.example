# Gravewright VTT — Django / ASGI configuration
# Loaded automatically by main.py, manage.py and ASGI.
# Process environment takes precedence. Restart after changing values.
# Values containing ${...} stay literal; interpolation is disabled.
# Reference: docs/en/configuration.md | Português: docs/pt-BR/configuration.md

# ASGI development server. Start: uv run --locked python main.py.
GRAVEWRIGHT_HOST=127.0.0.1
GRAVEWRIGHT_PORT=3000

# Django: HTTP debug, allowed hosts and a persistent private secret.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Set a private random secret before disabling DJANGO_DEBUG.
# DJANGO_SECRET_KEY=

# Public HTTP(S) origin, no path or trailing slash; include non-default ports.
# Pins the WebSocket origin and Host. HTTPS enables Secure session/CSRF cookies.
# For HTTPS hosting set this, e.g. https://vtt.example.com; see deployment docs.
GRAVEWRIGHT_PUBLIC_ORIGIN=
# Optional Secure-cookie override; does not configure TLS or WebSocket origins.
# DJANGO_SECURE_COOKIES=true

# SQLite and private files. Relative paths start at the project root.
GRAVEWRIGHT_DATABASE=data/gravewright.sqlite3
GRAVEWRIGHT_MEDIA_ROOT=data/media

# Installable browser modules/systems. ZIP archives and extracted packages are
# kept here. The folder is created automatically when the first ZIP is installed.
GRAVEWRIGHT_MODULES_ROOT=data/media/modules

# Local extension source folders and trusted Django server apps.
GRAVEWRIGHT_API_MODULES_ROOT=extensions/api
GRAVEWRIGHT_DJANGO_MODULES_ROOT=extensions/django
GRAVEWRIGHT_SERVER_APPS=
# Extra import roots: use ':' on Linux/macOS and ';' on Windows.
GRAVEWRIGHT_SERVER_APP_PATHS=

# Authentication: attempts per IP and window in seconds.
GRAVEWRIGHT_AUTH_MAX_ATTEMPTS=30
GRAVEWRIGHT_AUTH_WINDOW_SECONDS=300

# Redis: empty for one development process; required for multiple processes.
GRAVEWRIGHT_REDIS_URL=

# Identity, default locale and privacy policy publication.
APP_NAME=Gravewright
DEFAULT_LOCALE=en
PRIVACY_ENABLED=false

# Campaigns. Retention: snapshot count and audit days.
CAMPAIGN_JOIN_CODE_ENABLED=true
CAMPAIGN_CLONE_ENABLED=true
CAMPAIGN_SNAPSHOTS_ENABLED=true
CAMPAIGN_SNAPSHOT_RETENTION=20
ADMINISTRATIVE_AUDIT_ENABLED=true
ADMINISTRATIVE_AUDIT_RETENTION_DAYS=180
TARGETED_HANDOUTS_ENABLED=true
CAMPAIGN_EXPORT_ENABLED=true

# Join codes: validity in hours, use limit and attempt window in seconds.
JOIN_CODE_DEFAULT_EXPIRES_HOURS=168
JOIN_CODE_MIN_EXPIRES_HOURS=1
JOIN_CODE_MAX_EXPIRES_HOURS=720
JOIN_CODE_MAX_USES_LIMIT=1000
JOIN_CODE_REDEEM_MAX_ATTEMPTS=10
JOIN_CODE_REDEEM_WINDOW_SECONDS=600

# Trusted immediate proxies: comma-separated IPs/CIDRs for client-IP forwarding
# and X-Forwarded-Proto (HTTP/WebSocket schemes). Empty ignores forwarding.
# Trust only your proxy network. Keep Daphne --proxy-headers disabled.
TRUSTED_PROXIES=

# SQLite: lock wait in seconds. DATABASE_ECHO configures SQL logging independently.
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# WebSocket: bytes per message, commands per second and burst capacity.
WS_MAX_MESSAGE_BYTES=65536
WS_COMMANDS_PER_SECOND=20
WS_BURST_COMMANDS=40

# Table: renderer diagnostics, search, lobby and dynamic lighting.
APP_DEBUG=false
COMMAND_PALETTE_ENABLED=true
LOBBY_READY_CHECK_ENABLED=true
DYNAMIC_LIGHTING_ENABLED=true

# Streaming: width, height and area in chunks. GM prefetch is automatic.
SCENE_VIEWPORT_MAX_WIDTH_CHUNKS=16
SCENE_VIEWPORT_MAX_HEIGHT_CHUNKS=16
SCENE_VIEWPORT_MAX_AREA_CHUNKS=256

# Fog: operations per command, polygon points, coordinates and version control.
FOG_MAX_OPS_PER_COMMAND=64
FOG_MAX_POLYGON_POINTS=128
FOG_MAX_COORDINATE_ABS=100000
FOG_REQUIRE_EXPECTED_VERSION=true

# Tokens per batch, markers per scene and measurements per user.
TOKEN_CREATE_MANY_MAX=50
BOARD_MARKERS_MAX_PER_SCENE=500
BOARD_MEASUREMENTS_MAX_PER_USER=50

# Journal attachments: limits in bytes.
JOURNAL_IMAGE_MAX_BYTES=10485760
JOURNAL_PDF_MAX_BYTES=26214400

# Maps: decoded pixels, upload bytes, dimensions in pixels and tile count.
GRAVEWRIGHT_MAP_MAX_PIXELS=64000000
MAP_UPLOAD_MAX_BYTES=53687091200
MAP_IMAGE_MAX_WIDTH=500000
MAP_IMAGE_MAX_HEIGHT=500000
MAP_MAX_TILE_COUNT=4096

# Marketplace: optional HTTPS catalog and Ed25519 public keys. Local ZIP
# installation works without either setting.
GRAVEWRIGHT_MARKETPLACE_URL=
GRAVEWRIGHT_MARKETPLACE_KEYS_FILE=

# owner/repo hosting Django releases (Gravewright-VERSION-django.zip).
# Empty disables discovery; legacy Litestar releases are never a fallback.
GRAVEWRIGHT_RELEASES_REPOSITORY=Gravewright/gravewright
