{
  "actions": {
    "add-item": {
      "target": "items",
      "type": "append",
      "value": "@drop.entry"
    },
    "pool-roll": {
      "formula": "successes(clamp(@sheet.pool.size, 1, 100), 6, clamp(@sheet.pool.target, 1, 6))",
      "label": "Roll success pool",
      "type": "roll"
    }
  }
}
