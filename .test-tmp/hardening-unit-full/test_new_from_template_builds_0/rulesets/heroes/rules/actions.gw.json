{
  "actions": {
    "add-effect": {
      "target": "effects",
      "type": "append",
      "value": "@drop.entry"
    },
    "add-item": {
      "target": "items",
      "type": "append",
      "value": "@drop.entry"
    },
    "roll-item-damage": {
      "formula": "@item.data.damage",
      "intent": "damage",
      "label": "Roll damage",
      "type": "roll"
    },
    "strength-check": {
      "formula": "1d20 + floor((@sheet.attributes.strength - 10) / 2) + @sheet.skills.athletics",
      "label": "Strength + Athletics check",
      "type": "roll"
    }
  }
}
