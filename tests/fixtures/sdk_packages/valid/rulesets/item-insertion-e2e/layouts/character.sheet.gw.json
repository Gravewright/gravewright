{
  "kind": "actorSheet",
  "system": "item-insertion-e2e",
  "actorType": "character",
  "id": "item-insertion-e2e-character",
  "title": {
    "bind": "core.name"
  },
  "body": {
    "type": "section",
    "children": [
      {
        "type": "itemList",
        "path": "sheet.inventory",
        "columns": [
          {
            "path": "name",
            "label": "Name"
          }
        ],
        "dropZone": {
          "id": "inventory",
          "accepts": [
            "item.equipment"
          ],
          "onDrop": "inventory.add"
        }
      }
    ]
  }
}
