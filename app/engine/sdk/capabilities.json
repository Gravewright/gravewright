  "forbidden": {
    "backend.execute": {
      "reason": "Packages must not execute backend code."
    },
    "database.raw": {
      "reason": "Packages must not access raw database APIs."
    },
    "filesystem.raw": {
      "reason": "Packages must not access arbitrary filesystem paths."
    },
