{
  "$schema": "https://raw.githubusercontent.com/Gravewright/gravewright/main/schemas/gravewright-package-v1.schema.json",
  "schemaVersion": 1,
  "sdkVersion": "1",
  "kind": "addon",
  "id": "black-vault",
  "name": "Black Vault",
  "version": "0.2.0",
  "description": "SDK 1 RC 1 conformance module: a cooperative supernatural infiltration mission.",
  "authors": [
    "Gravewright SDK Conformance"
  ],
  "license": "MIT",
  "compatibility": {
    "minimum": "1",
    "verified": "1",
    "maximum": "1.x"
  },
  "capabilities": [
    "actors.data.write",
    "actors.read",
    "assets.audio",
    "assets.scripts",
    "assets.ui",
    "audio.playback",
    "campaign.members.read",
    "cards.manage",
    "cards.read",
    "content.references",
    "events.subscribe",
    "gameplay.flows.manage",
    "gameplay.flows.participate",
    "gameplay.flows.read",
    "input.commands",
    "interactions.request",
    "interactions.respond",
    "journals.read",
    "journals.write",
    "navigation.scene",
    "rules.actions",
    "scene.geometry.read",
    "scene.geometry.write",
    "scene.objectTypes.register",
    "scene.objects.interact",
    "scene.objects.read",
    "scene.objects.write",
    "scene.read",
    "scene.spatialSounds.read",
    "scene.spatialSounds.write",
    "scene.zones.read",
    "scene.zones.write",
    "settings",
    "sounds.read",
    "sounds.write",
    "storage.sqlite",
    "timelines.read",
    "timelines.start",
    "tokens.read",
    "tokens.transfer",
    "ui.applications",
    "ui.dragDrop",
    "ui.presentations",
    "ui.slots",
    "workflows.read",
    "workflows.start"
  ],
  "activation": {
    "scope": "campaign",
    "mode": "multiple"
  },
  "entrypoints": {
    "game": {
      "scripts": [
        "assets/black-vault.js"
      ]
    }
  },
  "settings": [
    {
      "key": "difficulty",
      "type": "string",
      "label": "Black Vault difficulty",
      "default": "standard",
      "scope": "campaign",
      "options": [
        "standard",
        "hardened"
      ]
    },
    {
      "key": "tutorialHints",
      "type": "boolean",
      "label": "Show tutorial hints",
      "default": true,
      "scope": "user"
    }
  ],
  "storage": {
    "sqlite": {
      "scopes": [
        "campaign"
      ],
      "migrations": "storage/migrations",
      "queries": "storage/queries.json",
      "maxSizeMB": 4
    }
  },
  "provides": {
    "assets": {
      "audio": [
        {
          "id": "generator-hum",
          "label": "Generator Hum",
          "path": "audio/generator-hum.ogg"
        },
        {
          "id": "security-alarm",
          "label": "Security Alarm",
          "path": "audio/security-alarm.ogg"
        }
      ]
    },
    "rules": {
      "actionRegistry": "rules/actions.gw.json",
      "cardRegistry": "rules/cards.gw.json"
    }
  }
}
