# Local secrets and environment overrides; keep the public configuration sample.
.env
.env.*
!.env.example
.direnv/

# Installed dependencies and Python/tool caches.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.tox/
.nox/

# Python packaging and root-level build output.
/build/
/dist/
*.egg-info/
.eggs/

# Local SQLite databases, including transaction journals and WAL sidecars.
*.sqlite3
*.sqlite3-*
*.sqlite
*.sqlite-*

# Private runtime storage and collected copies of application static files.
/data/*
!/data/.gitkeep
/media/
/staticfiles/
/backups/
/tmp/

# Operator-installed extensions; keep the folders and their documentation.
/extensions/api/*
/extensions/django/*
!/extensions/api/README*.md
!/extensions/django/README*.md

# Test diagnostics, coverage reports and runtime logs.
/test-results/
/playwright-report/
/blob-report/
.coverage
.coverage.*
/htmlcov/
/coverage/
/coverage.xml
/logs/
*.log
*.log.[0-9]*

# Editor temporary files and operating-system metadata.
*~
*.swp
*.swo
.DS_Store
._*
Thumbs.db
Desktop.ini

# Machine-specific shortcut generated by the Windows launcher.
/Gravewright Runner.lnk
/.Gravewright-*.lnk

# Generated documentation archives; source Markdown remains versioned.
/docs/*.zip

# Keep application static assets/bundles, vendor code and notices, migrations,
# test fixtures, generated API contracts, uv.lock and package-lock.json versioned.
