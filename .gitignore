# Runtime/user data at repository root only
/storage/
/scenes/
/uploads/
/tmp/
/temp/
/.test-tmp/
/diagnostics/

# ``data/`` mistura dados de execução e pacotes instalados localmente. Nenhum
# módulo/addon entra no repositório; a única exceção versionada é o ruleset PDF
# mantido pelo próprio projeto.
/data/*
!/data/packages/
/data/packages/*
!/data/packages/rulesets/
/data/packages/rulesets/*
!/data/packages/rulesets/gravewright-pdf-system/
!/data/packages/rulesets/gravewright-pdf-system/**

# Ficha em PDF enviada pelo GM vive na biblioteca de assets da campanha, não aqui.
# Dentro do pacote fica só o template que ele traz de fábrica.
/data/packages/rulesets/gravewright-pdf-system/assets/sheets/*
!/data/packages/rulesets/gravewright-pdf-system/assets/sheets/blank-a4.pdf

# Cópias locais de módulos e repositórios usados como referência/importação.
