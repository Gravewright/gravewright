{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "documentType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": ["id", "label"],
      "additionalProperties": false
    },
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sdk": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "string",
          "minLength": 1
        },
        "tested": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "requires",
        "tested"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80},
            "path": {"type": "string", "minLength": 1}
          },
          "required": ["name", "path"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "description": "Registers this package ID and name as an installed campaign system.",
      "properties": {
        "actorTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/documentType"}
        },
        "itemTypes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/documentType"}
        }
      },
      "required": ["actorTypes"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "sdk",
    "entry",
    "description",
    "author",
    "license"
  ],
  "additionalProperties": false
}
