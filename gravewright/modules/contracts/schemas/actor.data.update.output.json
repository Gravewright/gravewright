{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    }
  },
  "required": [
    "id",
    "revision",
    "data"
  ],
  "additionalProperties": false
}
