{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@gravewright/sdk": ["./packages/sdk/src/index.ts"],
      "@gravewright/kernel": ["./packages/kernel/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "modules", "packages", "scripts", "tests"]
}
